#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    combos {
        compatible = "zmk,combos";

        middle_click {
            bindings = <&mkp MB3>;
            key-positions = <28 27 26>;
        };

        right_click {
            bindings = <&mkp MB2>;
            key-positions = <28 27>;
        };

        left_click {
            bindings = <&mkp MB1>;
            key-positions = <27 26>;
        };
    };

    behaviors {
        scr_beh: scr_beh {
            compatible = "zmk,behavior-hold-tap";
            label = "SCR_BEH";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            hold-while-undecided;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp GRAVE   &kp N1  &kp N2  &kp N3     &kp N4            &kp N5          &kp N6     &kp N7           &kp N8     &kp N9   &kp N0    &kp BACKSPACE
&kp TAB     &kp Q   &kp W   &kp E      &kp R             &kp T           &kp Y      &kp U            &kp I      &kp O    &kp P     &kp BSLH
&kp ESCAPE  &kp A   &kp S   &kp D      &kp F             &scr_beh 4 G    &kp H      &kp J            &kp K      &kp L    &kp SEMI  &kp SQT
&kp MINUS   &kp Z   &kp X   &kp C      &kp V             &lt 3 B         &kp N      &kp M            &kp COMMA  &kp DOT  &kp FSLH  &kp EQUAL
                            &kp SPACE  &kp LEFT_ALT      &kp LEFT_GUI    &kp ENTER  &kp RIGHT_SHIFT
                                       &kp LEFT_CONTROL  &mo 1           &mo 2
            >;
        };

        num {
            bindings = <
&kp F1  &kp F2  &kp F3        &kp F4        &kp F5        &kp F6           &kp F7           &kp F8          &kp F9          &kp F10          &kp F11  &kp F12
&trans  &trans  &kp N7        &kp N8        &kp N9        &kp C_BRI_INC    &kp C_VOLUME_UP  &kp HOME        &kp UP_ARROW    &kp PG_UP        &trans   &trans
&trans  &trans  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp C_BRI_DEC    &kp C_VOL_DN     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans   &trans
&trans  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp DELETE       &kp PRINTSCREEN  &kp END         &kp CAPS        &kp PAGE_DOWN    &trans   &trans
                              &trans        &trans        &trans           &trans           &trans
                                            &trans        &trans           &trans
            >;
        };

        sym {
            bindings = <
&trans  &trans  &kp AT_SIGN           &kp AMPERSAND    &kp CARET              &trans          &trans     &trans                &trans          &trans            &trans  &trans
&trans  &trans  &kp LESS_THAN         &kp COLON        &kp RIGHT_BRACKET      &kp PLUS        &kp TILDE  &kp HASH              &kp UNDERSCORE  &kp PERCENT       &trans  &trans
&trans  &trans  &kp LEFT_PARENTHESIS  &kp SEMICOLON    &kp RIGHT_PARENTHESIS  &kp EQUAL       &kp GRAVE  &kp LESS_THAN         &kp MINUS       &kp GREATER_THAN  &trans  &trans
&trans  &trans  &kp LEFT_BRACE        &kp EXCLAMATION  &kp RIGHT_BRACE        &kp ASTERISK    &kp PIPE   &kp NON_US_BACKSLASH  &kp AMPERSAND   &kp SLASH         &trans  &trans
                                      &trans           &trans                 &trans          &trans     &trans
                                                       &trans                 &trans          &trans
            >;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &bt BT_CLR    &trans        &trans          &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
                                      &trans        &trans        &trans          &trans      &trans
                                                    &trans        &trans          &trans
            >;
        };

        scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };
    };
};

&trackball_listener {
    scroller {
        layers = <4>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            <&zip_xy_scaler 1 32>,
            <&zip_xy_to_scroll_mapper>;
    };
};
